#!/usr/bin/env node
// SNUSKAMPEN – hämtar produktbilder från Snusets officiella Vendure Shop API.
// Kör från repo-roten:  node tools/fetch-images.mjs
// Kräver Node 18+. Inga beroenden.
//
// 1. Läser hela katalogen från https://api.snuset.se/shop-api (paginerat).
// 2. Matchar mot products.js på märke + produktnamn (normaliserat, sedan fuzzy).
// 3. Laddar ner bilderna till img/<id>.<ext> och skriver images.js (manifest).
// 4. Skriver tools/report-unmatched.txt med det som inte matchade.

import fs from 'node:fs/promises';
import path from 'node:path';

const API = 'https://api.snuset.se/shop-api';
const TOKEN = 'sweden_webshop';
const ROOT = path.resolve(process.cwd());
const IMGDIR = path.join(ROOT, 'img');
const PAGE = 100;
const DELAY = 150;                 // ms mellan bildnedladdningar – var snäll mot servern

const sleep = ms => new Promise(r => setTimeout(r, ms));

async function gql(query, variables = {}) {
  const res = await fetch(API, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'vendure-token': TOKEN },
    body: JSON.stringify({ query, variables }),
  });
  if (!res.ok) throw new Error(`HTTP ${res.status} ${res.statusText}`);
  const json = await res.json();
  if (json.errors?.length) throw new Error(json.errors.map(e => e.message).join('; '));
  return json.data;
}

const QUERY = `
query Catalogue($skip: Int!, $take: Int!) {
  products(options: { skip: $skip, take: $take }) {
    totalItems
    items {
      id
      name
      slug
      featuredAsset { source preview }
      assets { source preview }
      facetValues { name facet { code name } }
      variants { name sku featuredAsset { source preview } }
    }
  }
}`;

async function loadCatalogue() {
  let skip = 0, total = Infinity, all = [];
  while (skip < total) {
    const d = await gql(QUERY, { skip, take: PAGE });
    total = d.products.totalItems;
    all.push(...d.products.items);
    process.stdout.write(`\rHämtar katalog: ${all.length}/${total}`);
    skip += PAGE;
    await sleep(80);
  }
  process.stdout.write('\n');
  return all;
}

// ---- normalisering och matchning
const norm = s => String(s || '')
  .toLowerCase()
  .normalize('NFKD').replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, ' ')
  .replace(/\b(portion|slim|mini|large|superslim|super slim|white|vit|original|dry|stark|strong|extra|nikotin|nicotine|pouches|pouch|snus)\b/g, ' ')
  .replace(/\s+/g, ' ').trim();

const tokens = s => new Set(norm(s).split(' ').filter(Boolean));
function score(a, b) {
  const A = tokens(a), B = tokens(b);
  if (!A.size || !B.size) return 0;
  let hit = 0; for (const x of A) if (B.has(x)) hit++;
  return (2 * hit) / (A.size + B.size);          // Dice
}

function brandOf(p) {
  const f = p.facetValues?.find(v => v.facet?.code === 'brand' || /brand|varum/i.test(v.facet?.name || ''));
  return f?.name || '';
}

async function main() {
  const productsJs = await fs.readFile(path.join(ROOT, 'products.js'), 'utf8');
  const body = productsJs.slice(productsJs.indexOf('[') + 1, productsJs.lastIndexOf(']'));
  const MINE = body.split('\n').map(l => l.trim().replace(/,$/, ''))
    .filter(l => l.startsWith('{')).map(l => JSON.parse(l));
  console.log(`products.js: ${MINE.length} produkter`);

  const cat = await loadCatalogue();
  console.log(`Snuset: ${cat.length} produkter`);

  // indexera katalogen per normaliserat märke
  const byBrand = new Map();
  for (const c of cat) {
    const b = norm(brandOf(c)) || norm(c.name.split(' ')[0]);
    if (!byBrand.has(b)) byBrand.set(b, []);
    byBrand.get(b).push(c);
  }

  await fs.mkdir(IMGDIR, { recursive: true });
  const manifest = {};
  const unmatched = [];
  let downloaded = 0, skipped = 0;

  for (const p of MINE) {
    const nb = norm(p.brand);
    const pool = byBrand.get(nb) || cat;                 // faller tillbaka på hela katalogen
    let best = null, bestScore = 0;
    for (const c of pool) {
      const s = score(`${p.brand} ${p.name}`, `${brandOf(c)} ${c.name}`);
      if (s > bestScore) { bestScore = s; best = c; }
    }
    const url = best?.featuredAsset?.source || best?.assets?.[0]?.source
             || best?.variants?.find(v => v.featuredAsset)?.featuredAsset?.source;
    if (!best || bestScore < 0.55 || !url) {
      unmatched.push(`${p.id}\t${p.brand} ${p.name}\tbästa: ${best ? brandOf(best) + ' ' + best.name : '–'} (${bestScore.toFixed(2)})`);
      continue;
    }
    const ext = (new URL(url).pathname.match(/\.([a-z0-9]+)$/i)?.[1] || 'png').toLowerCase();
    const file = `${p.id}.${ext}`;
    const dest = path.join(IMGDIR, file);
    manifest[p.id] = file;
    try { await fs.access(dest); skipped++; continue; } catch {}
    try {
      const r = await fetch(url);
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      await fs.writeFile(dest, Buffer.from(await r.arrayBuffer()));
      downloaded++;
      process.stdout.write(`\rLaddar ner: ${downloaded} (hoppade över ${skipped})`);
      await sleep(DELAY);
    } catch (e) {
      delete manifest[p.id];
      unmatched.push(`${p.id}\t${p.brand} ${p.name}\tnedladdning misslyckades: ${e.message}`);
    }
  }
  process.stdout.write('\n');

  await fs.writeFile(path.join(ROOT, 'images.js'),
    '// Genererad av tools/fetch-images.mjs. id → filnamn i /img/.\nwindow.IMAGES = ' +
    JSON.stringify(manifest, null, 0) + ';\n');
  await fs.writeFile(path.join(ROOT, 'tools', 'report-unmatched.txt'),
    `Utan bild: ${unmatched.length} av ${MINE.length}\n\n` + unmatched.join('\n') + '\n');

  console.log(`\nKlart.`);
  console.log(`  Bilder:      ${Object.keys(manifest).length} av ${MINE.length}`);
  console.log(`  Nedladdade:  ${downloaded}   Fanns redan: ${skipped}`);
  console.log(`  Utan bild:   ${unmatched.length}  → tools/report-unmatched.txt`);
  console.log(`\nLägg till images.js i index.html om det inte redan finns, sedan: git add . && git commit && git push`);
}

main().catch(e => { console.error('\nFEL:', e.message); process.exit(1); });
